# Docker pilot, iterace 5 (personal/devbot/CLAUDE.md) — obraz pro skupinu
# projektových botů (zatím jen fbalbums), mirror Dockerfile.daily. Absolutní
# cesty uvnitř kontejneru zrcadlí hostitelské, stejný důvod jako u denní
# skupiny (.env.<profil> cesty v bridge-ts/src/config.ts).
FROM node:20-slim

# Single place to bump the claude CLI version: keep it equal to `claude --version` on
# the host (2.1.291 when written; the previous pin 2.1.280 had drifted). Dockerfile.daily
# and Dockerfile.project must carry the same default. Override per build with
# `docker compose build --build-arg CLAUDE_CLI_VERSION=x.y.z`. Bumping needs an image
# rebuild + container recreate.
ARG CLAUDE_CLI_VERSION=2.1.291

# `procps` (pgrep/pkill) — watchdog.sh a dashboard restart tlačítko se do kontejneru
# `exec`ují (stejný důvod jako Dockerfile.daily, iterace 8).
# `git` navíc oproti Dockerfile.daily — fbalbums si otevírá `git worktree`
# přes EnterWorktree/ExitWorktree nad vlastním produktovým repem
# (/home/agent/fbalbums) pro svůj vývojový cyklus; bez něj by worktree
# krok v kontejneru hned selhal na "git: command not found".
RUN apt-get update && apt-get install -y --no-install-recommends git procps \
    && rm -rf /var/lib/apt/lists/*

# Version comes from the CLAUDE_CLI_VERSION ARG at the top (same as Dockerfile.daily) —
# stejný důvod jako tam, sladit ručně při aktualizaci hostitelského CLI.
RUN npm install -g @anthropic-ai/claude-code@${CLAUDE_CLI_VERSION}

WORKDIR /home/agent/agent-system/bridge-ts
COPY bridge-ts/package.json bridge-ts/package-lock.json ./
RUN npm ci
COPY bridge-ts/tsconfig.json ./tsconfig.json
COPY bridge-ts/src ./src

COPY start-project.sh /start-project.sh
RUN chmod +x /start-project.sh

# Stejný důvod jako Dockerfile.daily: claudeProcess.ts píše
# bridge_ts_<profil>_claude_stderr.log přímo do /home/agent/agent-system/,
# mimo bind-mountnuté adresáře — bez vlastnictví padá na EACCES pod
# user: 1000:1000 (docker-compose.project.yml).
RUN chown 1000:1000 /home/agent/agent-system

CMD ["/start-project.sh"]
